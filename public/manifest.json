{
  "manifest_version": 3,
  "name": "Reach for the Stars",
  "version": "0.4.2",
  "description": "Get a visual representation of how many people you've reached and the size of your impact.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Reach for the Stars"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.buffer.com/*"
  ],
  "icons": {
    "16": "images/icon-star.png",
    "48": "images/icon-star.png",
    "128": "images/icon-star.png"
  }
}
